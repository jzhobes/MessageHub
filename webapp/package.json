{
  "name": "messagehub-webapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "demo:export": "node scripts/export-demo-data.mjs",
    "build:demo": "npm run demo:export && node scripts/build-demo.mjs",
    "preview:demo": "npx --yes serve out -l 4173",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "validate": "npm run lint -- --fix && npm run format && npm run type-check && npm run test",
    "pretest": "cd .. && ./build_samples.sh",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "clean": "rm -rf .next",
    "clean:all": "npm run clean && cd .. && rm -rf venv data_samples"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "better-sqlite3": "^13.2.0",
    "dompurify": "^3.4.18",
    "formidable": "^3.5.4",
    "guarded-fetch": "^0.3.0",
    "html-entities": "^2.6.0",
    "jszip": "^3.10.2",
    "next": "16.4.6",
    "parse5": "^8.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "react-virtuoso": "^4.18.23",
    "tiktoken": "^1.0.22"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.3.2",
    "@testing-library/react": "^16.3.3",
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/formidable": "^3.5.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.1",
    "node-mocks-http": "^1.18.1",
    "prettier": "^3.10.1",
    "typescript": "^5",
    "vite": "^8.0.0",
    "vitest": "^5.1.1"
  }
}
